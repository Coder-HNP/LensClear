# LensClear Team Testing Environment

PORT=5000
MONGODB_URI=mongodb://mongodb:27017/lensclear
JWT_SECRET=team_testing_secret_DO_NOT_USE_IN_PRODUCTION
MQTT_PORT=1883
FRONTEND_URL=http://localhost:5173
ENABLE_MQTT=true

# Frontend build-time variables
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5173

# MongoDB (optional - uncomment for authentication)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=lensclear_test_password
