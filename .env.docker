# ============================================
# LensClear Docker Environment Configuration
# ============================================
# Copy this file to .env and update values for your deployment

# ============================================
# Backend Configuration
# ============================================
PORT=5000
MONGODB_URI=mongodb://mongodb:27017/lensclear
JWT_SECRET=change_this_to_a_secure_random_string_in_production
MQTT_PORT=1883
FRONTEND_URL=http://localhost:5173

# Optional: Disable MQTT broker if not needed
# ENABLE_MQTT=false

# ============================================
# Frontend Configuration
# ============================================
# These are build-time variables for Vite
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5173

# ============================================
# MongoDB Configuration
# ============================================
# Optional: Add authentication for production
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=secure_password

# ============================================
# Production Settings
# ============================================
# For production deployment, update these:
# - Change JWT_SECRET to a strong random string
# - Update FRONTEND_URL to your actual domain
# - Enable MongoDB authentication
# - Consider using Docker secrets for sensitive data
